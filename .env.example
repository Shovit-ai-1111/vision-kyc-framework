PORT=8080

KYC_OCR_ENGINE=tesseract
KYC_NER_ENGINE=crf
KYC_DETECTOR=mtcnn
KYC_FACE_WEIGHTS=vggface2
KYC_RETENTION_HOURS=24

# Leave empty to generate /data/reviewer-key.
KYC_REVIEWER_KEY=

# Keep this secret and never commit .env.
GEMINI_API_KEY=yourapikey
KYC_GEMINI_ENABLED=true
KYC_GEMINI_MODEL=gemini-3.5-flash-lite
KYC_GEMINI_ATTEMPTS=3
KYC_GEMINI_TIMEOUT_SECONDS=20
KYC_OCR_VARIANTS=5
KYC_OCR_SECONDARY=false